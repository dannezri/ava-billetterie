# =============================================================================
# CONFIGURATION ENVIRONNEMENT - AVA TICKETING PLATFORM
# =============================================================================
# Ce fichier contient toutes les variables d'environnement nécessaires
# Copier ce fichier et le renommer en .env.local pour le développement
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ava

# Liste des emails admin (séparés par des virgules)
# Ces utilisateurs auront accès au dashboard admin de validation
ADMIN_EMAILS=admin@ava-tickets.com,admin2@ava-tickets.com

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL via Supabase/Railway)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/ava_dev

# -----------------------------------------------------------------------------
# SUPABASE (Authentication & Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# NEXTAUTH (Session & Security)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# STRIPE (Payments & Escrow & Connect)
# -----------------------------------------------------------------------------
# Clés API Stripe (Test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (obtenu via Dashboard ou Stripe CLI)
# En local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# KYC / Identity Verification
STRIPE_IDENTITY_VERIFICATION_SESSION_RETURN_URL=http://localhost:3000/kyc/verify

# Ticket Security (Signature HMAC pour URLs sécurisées)
# Générer avec: openssl rand -base64 32
TICKET_SIGNATURE_SECRET=generate-with-openssl-rand-base64-32

# Stripe Connect - URLs de retour après onboarding
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/seller/onboarding/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/seller/onboarding/complete

# -----------------------------------------------------------------------------
# FILE UPLOAD (Uploadcare)
# -----------------------------------------------------------------------------
# Uploadcare - Service d'upload sécurisé pour les billets PDF
# Inscription: https://uploadcare.com/
# Dashboard: https://app.uploadcare.com/
# 
# Configuration:
# - Taille max: 5 MB
# - Formats acceptés: PDF uniquement
# - Sécurité: Scan antivirus automatique, signatures sécurisées
#
# Obtenir les clés:
# 1. Créer un compte sur https://uploadcare.com/
# 2. Créer un nouveau projet
# 3. Aller dans Settings > API keys
# 4. Copier Public Key et Secret Key
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=your-public-key
UPLOADCARE_SECRET_KEY=your-secret-key

# -----------------------------------------------------------------------------
# EMAIL (Resend ou SendGrid)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
NEXT_PUBLIC_EMAIL_FROM=noreply@ava-tickets.com

# -----------------------------------------------------------------------------
# IA — GEMINI (Google Generative AI)
# -----------------------------------------------------------------------------
# Utilisé pour valider et corriger le mapping des champs extraits des PDFs billets.
# Obtenir une clé: https://aistudio.google.com/app/apikey
# Modèle: gemini-1.5-flash (rapide, économique, JSON natif)
# Si absent, l'extraction fonctionne uniquement via regex (confiance < 100%).
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# AUTO-FETCH IMAGE ARTISTE (optionnel — enrichissement automatique)
# -----------------------------------------------------------------------------
# Déclenché lors de la création d'un événement admin sans image manuelle.
# Ordre de priorité : Spotify → Last.fm → Google Custom Search

# Spotify API — recommandé (gratuit, illimité, images haute qualité)
# Création : https://developer.spotify.com/dashboard → Create app → Settings
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Last.fm API — fallback 1 (gratuit)
# Clé gratuite : https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key

# Google Custom Search — fallback 2 (100 req/jour gratuit, puis payant)
# Console : https://console.cloud.google.com/ → Custom Search JSON API
# Moteur de recherche : https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=your-google-api-key
GOOGLE_CUSTOM_SEARCH_CX=your-search-engine-cx

# -----------------------------------------------------------------------------
# TICKETMASTER API (Import événements admin)
# -----------------------------------------------------------------------------
# Permet l'import automatique des 50 plus gros concerts musicaux en France
# Création compte : https://developer.ticketmaster.com/
# → Créer une app → Copier la "Consumer Key"
# Rate limit : 5 000 req/jour (gratuit, largement suffisant pour un usage admin)
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key

# -----------------------------------------------------------------------------
# MONITORING & ANALYTICS (optionnel)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# CRON JOBS (Vercel Scheduler)
# -----------------------------------------------------------------------------
# Secret partagé entre Vercel Cron et l'endpoint /api/cron/release-expired
# Générer avec: openssl rand -base64 32
# À définir aussi dans les variables d'environnement Vercel (Settings > Env Vars)
CRON_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_DISPUTES=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_MAX_TICKET_PRICE=5000

# TEST / DÉVELOPPEMENT UNIQUEMENT
# -----------------------------------------------------------------------------
# Mettre à true pour permettre plusieurs billets avec le même code-barres (tests)
SKIP_DUPLICATE_TICKET_CHECK=false

# Switcher de profil test dans le Header (dev uniquement)
NEXT_PUBLIC_TEST_USER_SWITCHER=false
NEXT_PUBLIC_TEST_BUYER_EMAIL=buyer@test.ava
NEXT_PUBLIC_TEST_BUYER_PASSWORD=
NEXT_PUBLIC_TEST_SELLER_EMAIL=seller@test.ava
NEXT_PUBLIC_TEST_SELLER_PASSWORD=
