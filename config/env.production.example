# =============================================================================
# ENVIRONNEMENT PRODUCTION
# =============================================================================
# Variables d'environnement pour l'environnement de production
# À configurer sur Vercel: vercel env add [VAR_NAME] production
# ⚠️ ATTENTION: Utiliser des valeurs sécurisées et des clés API LIVE
# =============================================================================

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://ava-tickets.com
NEXT_PUBLIC_APP_NAME=Ava

# Database (instance production avec backup automatique)
DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/ava_production

# Supabase (projet production)
NEXT_PUBLIC_SUPABASE_URL=https://prod-xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NextAuth (secret cryptographiquement fort)
NEXTAUTH_URL=https://ava-tickets.com
NEXTAUTH_SECRET=use-strong-random-secret-minimum-32-chars

# Stripe (mode LIVE - clés production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51...
STRIPE_SECRET_KEY=sk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_live_...
STRIPE_IDENTITY_VERIFICATION_SESSION_RETURN_URL=https://ava-tickets.com/kyc/verify

# Uploadcare (compte production)
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=prod-public-key
UPLOADCARE_SECRET_KEY=prod-secret-key

# Email (compte Resend production)
RESEND_API_KEY=re_live_...
NEXT_PUBLIC_EMAIL_FROM=noreply@ava-tickets.com

# Monitoring (REQUIS en production)
SENTRY_DSN=https://prod-xxx@sentry.io/xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_prod_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags (contrôlées en production)
NEXT_PUBLIC_ENABLE_DISPUTES=true
NEXT_PUBLIC_ENABLE_REVIEWS=false
NEXT_PUBLIC_MAX_TICKET_PRICE=5000
