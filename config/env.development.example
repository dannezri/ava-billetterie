# =============================================================================
# ENVIRONNEMENT DEVELOPMENT (Local)
# =============================================================================
# Ce fichier sert d'exemple pour configurer votre environnement de développement
# Copier ce fichier en .env.local et remplir les valeurs
# =============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ava (Dev)

# Database (PostgreSQL local ou Supabase dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ava_dev

# Supabase (créer un projet dev sur https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NextAuth (générer avec: npm run env:secret)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me

# Stripe (mode test - https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_IDENTITY_VERIFICATION_SESSION_RETURN_URL=http://localhost:3000/kyc/verify

# Uploadcare (https://uploadcare.com)
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=demopublickey
UPLOADCARE_SECRET_KEY=demoprivatekey

# Email - Resend (https://resend.com)
RESEND_API_KEY=re_dev_...
NEXT_PUBLIC_EMAIL_FROM=dev@localhost

# Monitoring (optionnel en dev)
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Feature Flags (toutes activées en dev)
NEXT_PUBLIC_ENABLE_DISPUTES=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_MAX_TICKET_PRICE=5000
