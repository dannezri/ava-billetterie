# =============================================================================
# ENVIRONNEMENT STAGING
# =============================================================================
# Variables d'environnement pour l'environnement de staging
# À configurer sur Vercel: vercel env add [VAR_NAME] preview
# =============================================================================

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.ava-tickets.com
NEXT_PUBLIC_APP_NAME=Ava (Staging)

# Database (instance staging sur Supabase/Railway)
DATABASE_URL=postgresql://user:password@staging-db.example.com:5432/ava_staging

# Supabase (projet staging dédié)
NEXT_PUBLIC_SUPABASE_URL=https://staging-xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NextAuth (secret fort pour staging)
NEXTAUTH_URL=https://staging.ava-tickets.com
NEXTAUTH_SECRET=generate-strong-secret-for-staging

# Stripe (mode test avec clés dédiées staging)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_staging_...
STRIPE_IDENTITY_VERIFICATION_SESSION_RETURN_URL=https://staging.ava-tickets.com/kyc/verify

# Uploadcare (compte staging)
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=staging-public-key
UPLOADCARE_SECRET_KEY=staging-secret-key

# Email (compte Resend staging)
RESEND_API_KEY=re_staging_...
NEXT_PUBLIC_EMAIL_FROM=staging@ava-tickets.com

# Monitoring (actif en staging)
SENTRY_DSN=https://staging-xxx@sentry.io/xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_staging_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags (tester les nouvelles features)
NEXT_PUBLIC_ENABLE_DISPUTES=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_MAX_TICKET_PRICE=5000
