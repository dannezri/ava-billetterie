// Prisma schema based on MVP database design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Pour migrations (sans pooling)
}

// ============================================================================
// USERS
// ============================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  phone     String?
  
  kycStatus        KYCStatus @default(PENDING) @map("kyc_status")
  kycProviderId    String?   @map("kyc_provider_id")
  verifiedIdentity Boolean   @default(false) @map("verified_identity")
  stripeAccountId  String?   @map("stripe_account_id")
  trustScore       Int       @default(50) @map("trust_score")

  // ✨ Tracking ventes (tout user qui vend, sans notion de "role SELLER")
  hasSoldTickets   Boolean   @default(false) @map("has_sold_tickets")
  firstSaleAt      DateTime? @map("first_sale_at")
  totalSales       Int       @default(0) @map("total_sales")
  totalRevenue     Decimal   @default(0) @map("total_revenue") @db.Decimal(10, 2)

  // Dispute stats (vendeur)
  disputesAsSellerCount   Int @default(0) @map("disputes_as_seller_count")
  disputesResolvedAgainst Int @default(0) @map("disputes_resolved_against")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  ticketsForSale       Ticket[]      @relation("SellerTickets")
  ticketGroupsForSale  TicketGroup[] @relation("SellerTicketGroups")
  purchases            Transaction[] @relation("BuyerTransactions")
  sales                Transaction[] @relation("SellerTransactions")
  disputes         Dispute[]       @relation("DisputeReporter")
  resolvedDisputes Dispute[]       @relation("DisputeResolver")
  assignedDisputes Dispute[]       @relation("AssignedDisputes")
  disputeMessages  DisputeMessage[] @relation("DisputeMessageAuthor")
  reviewsGiven    Review[]      @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")
  auditLogs       AuditLog[]
  favorites       Favorite[]
  notifications         Notification[]
  userEventFollows      UserEventFollow[]
  notificationPreferences NotificationPreferences?
  
  @@index([email])
  @@index([kycStatus])
  @@index([trustScore])
  @@map("users")
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ============================================================================
// EVENTS
// ============================================================================

model Event {
  id             String    @id @default(uuid())
  title          String
  description    String?
  artist         String?
  venue          String
  city           String
  country        String    @default("France")
  eventDate      DateTime  @map("event_date")
  doorsOpenTime  String?   @map("doors_open_time")
  category       String?
  imageUrl       String?   @map("image_url")
  officialUrl    String?   @map("official_url")
  isVerified     Boolean   @default(false) @map("is_verified")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  tickets      Ticket[]
  ticketGroups TicketGroup[]
  favorites    Favorite[]
  userEventFollows UserEventFollow[]

  @@index([eventDate])
  @@index([city])
  @@index([artist])
  @@map("events")
}

// ============================================================================
// TICKET GROUPS (billets côte à côte vendus ensemble)
// ============================================================================

model TicketGroup {
  id         String            @id @default(uuid())
  eventId    String            @map("event_id")
  sellerId   String            @map("seller_id")
  quantity   Int
  totalPrice Decimal           @map("total_price") @db.Decimal(10, 2)
  section    String?
  status     TicketGroupStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seller  User     @relation("SellerTicketGroups", fields: [sellerId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
  @@index([sellerId])
  @@index([quantity])
  @@index([status])
  @@map("ticket_groups")
}

enum TicketGroupStatus {
  ACTIVE
  RESERVED
  SOLD
  CANCELLED
}

// ============================================================================
// TICKETS
// ============================================================================

model Ticket {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  sellerId  String   @map("seller_id")
  groupId   String?  @map("group_id")
  
  status            TicketStatus             @default(DRAFT)
  originalPrice     Decimal?                 @map("original_price") @db.Decimal(10, 2)
  price             Decimal                  @db.Decimal(10, 2)
  section           String?
  row               String?
  seatNumber        String?                  @map("seat_number")
  pdfUrl            String?                  @map("pdf_url")
  pdfHash           String?                  @map("pdf_hash")
  pdfSizeBytes      Int?                     @map("pdf_size_bytes")
  barcodeNumber     String?                  @map("barcode_number")
  barcodeType       String?                  @map("barcode_type") @db.VarChar(20)
  verificationStatus TicketVerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason   String?                  @map("rejection_reason")

  // ✨ Données extraites automatiquement du PDF
  extractedEventName String?  @map("extracted_event_name") @db.VarChar(255)
  extractedDate      DateTime? @map("extracted_date")
  extractedVenue     String?  @map("extracted_venue") @db.VarChar(255)
  extractedCity      String?  @map("extracted_city") @db.VarChar(100)
  extractedCategory  String?  @map("extracted_category") @db.VarChar(100)
  extractedSeat      String?  @map("extracted_seat") @db.VarChar(50)
  extractedPrice     Decimal? @map("extracted_price") @db.Decimal(10, 2)
  extractionConfidence Float? @map("extraction_confidence") // 0.0 à 1.0
  extractionWarnings Json?    @map("extraction_warnings")  // Array de strings
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expiresAt DateTime? @map("expires_at")
  
  // Relations
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seller      User          @relation("SellerTickets", fields: [sellerId], references: [id], onDelete: Cascade)
  group       TicketGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@index([barcodeNumber])
  @@index([status])
  @@index([verificationStatus])
  @@index([sellerId])
  @@index([eventId])
  @@map("tickets")
}

enum TicketStatus {
  DRAFT
  PENDING_VALIDATION
  ACTIVE
  RESERVED
  SOLD
  CANCELLED
  FLAGGED
}

enum TicketVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

model Transaction {
  id                    String   @id @default(uuid())
  ticketId              String   @unique @map("ticket_id")
  buyerId               String   @map("buyer_id")
  sellerId              String   @map("seller_id")
  
  amount                Decimal  @db.Decimal(10, 2)
  platformFee           Decimal  @map("platform_fee") @db.Decimal(10, 2)
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  stripeTransferId      String?  @unique @map("stripe_transfer_id") @db.VarChar(255)
  
  status              TransactionStatus @default(PENDING)
  escrowReleaseDate   DateTime          @map("escrow_release_date")
  releasedAt          DateTime?         @map("released_at")

  // ✨ Virement automatique par billet (J+2 après événement)
  autoPayoutStatus    AutoPayoutStatus  @default(PENDING) @map("auto_payout_status")
  autoPayoutDate      DateTime?         @map("auto_payout_date")
  autoPayoutError     String?           @map("auto_payout_error") @db.Text
  manualReview        Boolean           @default(false) @map("manual_review")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  ticket  Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  buyer   User      @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  User      @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  dispute Dispute?
  review  Review?
  
  @@index([status])
  @@index([escrowReleaseDate])
  @@index([buyerId])
  @@index([sellerId])
  @@index([autoPayoutStatus])
  @@index([stripePaymentIntentId])
  @@map("transactions")
}

enum TransactionStatus {
  PENDING
  CANCELLED
  COMPLETED
  ESCROWED
  RELEASED
  REFUNDED
  DISPUTED
}

enum AutoPayoutStatus {
  PENDING         // En attente (J+2 pas encore passé)
  PROCESSING      // Cron en cours de traitement
  COMPLETED       // Virement effectué
  FAILED          // Échec temporaire (retry demain)
  MANUAL_REVIEW   // Échec permanent (action manuelle requise)
}

// ============================================================================
// DISPUTES
// ============================================================================

model Dispute {
  id             String   @id @default(uuid())
  transactionId  String   @unique @map("transaction_id")
  reporterId     String   @map("reporter_id")
  
  reason          DisputeReason @default(OTHER)
  description     String
  evidenceUrls    String[]      @map("evidence_urls")
  
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?       @map("resolution_notes")
  refundAmount    Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  resolvedById    String?       @map("resolved_by_id")
  resolvedAt      DateTime?     @map("resolved_at")

  // Admin management
  assignedTo      String?       @map("assigned_to")
  stripeRefundId  String?       @map("stripe_refund_id")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  transaction    Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reporter       User             @relation("DisputeReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     User?            @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignedAdmin  User?            @relation("AssignedDisputes", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages       DisputeMessage[]
  
  @@index([status])
  @@index([reporterId])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("disputes")
}

model DisputeMessage {
  id         String   @id @default(uuid())
  disputeId  String   @map("dispute_id")
  authorId   String   @map("author_id")
  
  message     String  @db.Text
  attachments Json?
  isInternal  Boolean @default(false) @map("is_internal")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation("DisputeMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([disputeId])
  @@map("dispute_messages")
}

enum DisputeReason {
  FAKE_TICKET
  NO_ACCESS
  DUPLICATE
  EVENT_CANCELLED
  WRONG_TICKET
  SELLER_NO_RESPONSE
  OTHER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_REFUND
  RESOLVED_RELEASE
  CLOSED
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id              String   @id @default(uuid())
  transactionId   String   @unique @map("transaction_id")
  reviewerId      String   @map("reviewer_id")
  reviewedUserId  String   @map("reviewed_user_id")
  
  rating  Int
  comment String?
  
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  transaction  Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewer     User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User        @relation("ReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  
  @@index([reviewedUserId])
  @@index([rating])
  @@map("reviews")
}

// ============================================================================
// FAVORITES
// ============================================================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("favorites")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id       String @id @default(uuid())

  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String           @db.VarChar(255)
  message  String           @db.Text

  metadata  Json?
  linkUrl   String?  @map("link_url") @db.VarChar(500)
  ctaText   String?  @map("cta_text") @db.VarChar(50)

  isRead  Boolean   @default(false) @map("is_read")
  readAt  DateTime? @map("read_at")

  priority  NotificationPriority @default(MEDIUM)

  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("notifications")
}

enum NotificationType {
  TRANSACTION
  DISPUTE
  PRICE_ALERT
  SYSTEM
  SOCIAL
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model UserEventFollow {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  eventId String @map("event_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  alertOnNewTicket Boolean  @default(true) @map("alert_on_new_ticket")
  alertOnPriceDrop Boolean  @default(true) @map("alert_on_price_drop")
  priceThreshold   Decimal? @map("price_threshold") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("user_event_follows")
}

model NotificationPreferences {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailTransactions Boolean @default(true) @map("email_transactions")
  emailDisputes     Boolean @default(true) @map("email_disputes")
  emailPriceAlerts  Boolean @default(true) @map("email_price_alerts")
  emailSystem       Boolean @default(true) @map("email_system")

  pushEnabled Boolean @default(false) @map("push_enabled")
  pushSound   Boolean @default(true) @map("push_sound")

  dailyDigest Boolean @default(false) @map("daily_digest")
  digestTime  String  @default("09:00") @map("digest_time")

  priceAlertFrequency String @default("INSTANT") @map("price_alert_frequency")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id       String @id @default(uuid())
  userId   String? @map("user_id")
  
  action    AuditAction @default(ADMIN_ACTION)
  metadata  Json
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  TICKET_UPLOAD
  TICKET_RESERVED
  TICKET_PURCHASE
  KYC_ATTEMPT
  PAYMENT
  PAYMENT_INTENT_CREATED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  DISPUTE_CREATED
  ADMIN_ACTION
  PAYOUT_CREATED      // Legacy (ancien système de retrait manuel)
  PAYOUT_FAILED       // Legacy (ancien système de retrait manuel)
  AUTO_PAYOUT_COMPLETED
  AUTO_PAYOUT_FAILED
}
